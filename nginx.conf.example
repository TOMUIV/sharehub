# ShareHub 反向代理示例（nginx）
# 部署在 https://your.domain/share 子路径。若部署在根路径，把下面 location 的 /share 换成 / 即可。
# 关键：proxy_pass 末尾的 "/" 会把 /share 前缀剥离后再转发给后端（后端路由是绝对路径）。
# 同时容器须以 --prefix /share 启动（让前端生成的链接带 /share 前缀）。
# 分片上传走分块请求，务必设 client_max_body_size 0（不限制）。

location /share/ {
    proxy_pass http://127.0.0.1:18888/;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Connection "";
    proxy_buffering off;
    client_max_body_size 0;
    proxy_read_timeout 300s;
}
